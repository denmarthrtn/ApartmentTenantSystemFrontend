# Copy to .env.local and change what you need. Everything here is optional.

# Development: where Vite forwards /api requests (default http://localhost:5041)
# Use https://localhost:7253 when the API runs with the https profile (Visual Studio's default)
API_PROXY_TARGET=http://localhost:5041

# Production build: full URL of the API when it is on another domain.
# The API must allow this site's origin with CORS. Leave empty when both share a domain.
VITE_API_URL=

# Show the "use a demo account" buttons on the login page outside development
VITE_DEMO=false
